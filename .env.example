# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
# Optional: Server-side service role key (Admin CMS writes & Storage uploads already work out-of-the-box via Supabase Auth JWT + RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Optional (Recommended on Vercel): Vercel Blob storage token for permanent CDN image uploads
BLOB_READ_WRITE_TOKEN=

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Telegram & Instagram Alerts (can also be configured inside Admin CMS)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
INSTAGRAM_WEBHOOK_URL=
